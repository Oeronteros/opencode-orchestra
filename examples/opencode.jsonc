{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@oeronteros-1/opencode-orchestra",
      {
        "configFile": ".opencode/orchestra.jsonc"
      }
    ],
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git==2026.8.18", "--repository", "."],
      "cwd": ".",
      "enabled": true,
      "timeout": 120000
    },
    "ast-grep": {
      "type": "local",
      "command": ["uvx", "--with", "ast-grep-cli==0.45.1", "--from", "git+https://github.com/ast-grep/ast-grep-mcp@149e20d47bb7125fb0c1451feea2f48a98742034", "ast-grep-server"],
      "cwd": ".",
      "enabled": true,
      "timeout": 120000
    }
  }
}
