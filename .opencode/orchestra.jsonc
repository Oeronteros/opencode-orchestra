{
  "budget": "quality",
  "models": {
    "strategy": "manual",
    "agents": {
      "orch-lead": "opencode/x-preview-f-free",
      "orch-judge": "opencode/x-preview-f-free",
      "orch-repo": "opencode/x-preview-f-free",
      "orch-tests": "opencode/x-preview-f-free",
      "orch-critic": "opencode/x-preview-f-free",
      "orch-docs": "opencode/x-preview-f-free",
      "orch-research": "opencode/x-preview-f-free",
      "orch-security": "opencode/x-preview-f-free",
      "orch-visual-reference": "opencode/x-preview-f-free",
      "orch-visual-generate": "opencode/x-preview-f-free",
      "orch-visual-review": "opencode/x-preview-f-free"
    },
    "lead": [],
    "worker": {
      "code": [],
      "reasoning": [],
      "research": [],
      "vision": [],
      "image": []
    },
    "judge": []
  },
  "orchestration": {
    "parallelWorkers": 3,
    "maxWorkers": 5,
    "premiumEscalation": true,
    "maxPremiumCallsPerTask": 1,
    "confidenceThreshold": 0.72,
    "exposeWorkers": false,
    "profiles": {}
  },
  "superpowers": {
    "compatibility": true,
    "injectPrimaryHint": false
  },
  "telemetry": {
    "enabled": true,
    "directory": ".orchestra",
    "storeTexts": false
  },
  "pricing": {
    "refreshIntervalHours": 0,
    "estimate": true,
    "warnThresholdUSD": 0.5
  }
}
