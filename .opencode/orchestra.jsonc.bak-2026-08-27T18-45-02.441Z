{
  "budget": "quality",
  "models": {
    "strategy": "manual",
    "agents": {
      "orch-lead": "opencode-go/glm-5.3-flash",
      "orch-judge": "opencode-go/glm-5.3-flash",
      "orch-repo": "opencode-go/glm-5.3-flash",
      "orch-tests": "opencode-go/glm-5.3-flash",
      "orch-critic": "opencode-go/glm-5.3-flash",
      "orch-docs": "opencode-go/glm-5.3-flash",
      "orch-research": "opencode-go/glm-5.3-flash",
      "orch-security": "opencode-go/glm-5.3-flash",
      "orch-visual-reference": "opencode-go/glm-5.3-flash",
      "orch-visual-generate": "opencode-go/glm-5.3-flash",
      "orch-visual-review": "opencode-go/glm-5.3-flash"
    },
    "lead": [],
    "worker": {
      "code": [],
      "reasoning": [],
      "research": [],
      "vision": [],
      "image": []
    },
    "judge": [],
    "fallback": {
      "enabled": true,
      "maxRetries": 2
    }
  },
  "orchestration": {
    "parallelWorkers": 3,
    "maxWorkers": 5,
    "premiumEscalation": true,
    "maxPremiumCallsPerTask": 1,
    "confidenceThreshold": 0.72,
    "exposeWorkers": true,
    "profiles": {},
    "parallelEditors": 0
  },
  "superpowers": {
    "compatibility": true,
    "injectPrimaryHint": false
  },
  "telemetry": {
    "enabled": true,
    "directory": ".orchestra",
    "storeTexts": false,
    "anomalySigma": 2
  },
  "pricing": {
    "refreshIntervalHours": 0,
    "estimate": true,
    "warnThresholdUSD": 0.5,
    "openrouter": {
      "enabled": false,
      "ttlHours": 12
    },
    "aliases": []
  },
  "permissions": {
    "autoAcceptAll": true
  }
}
