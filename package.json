{
  "name": "@oeronteros-1/opencode-orchestra",
  "version": "0.5.2",
  "description": "Additive model and subagent orchestration for OpenCode",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agents",
    "orchestration"
  ],
  "files": [
    "dist",
    "dashboard-dist",
    "prompts",
    "schema",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./schema/opencode-orchestra.schema.json"
  },
  "bin": {
    "opencode-orchestra": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:dashboard && npm run build:plugin",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build:plugin": "tsc -p tsconfig.build.json",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/classifier.test.js dist-test/test/model-resolver.test.js dist-test/test/model-discovery.test.js dist-test/test/budget.test.js dist-test/test/agents.test.js dist-test/test/plugin.test.js dist-test/test/cli.test.js dist-test/test/dashboard.test.js dist-test/test/ledger.test.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "zustand": "^5.0.15"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  }
}
